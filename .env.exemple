# Copiez ce fichier sous le nom .env et remplissez vos valeurs.
# Le fichier .env ne doit jamais etre partage ni envoye sur GitHub :
# .gitignore l'exclut deja, ne le forcez pas.
#
# En ligne, ces memes valeurs se declarent dans les variables
# d'environnement de l'hebergeur, jamais dans un fichier.


# =====================================================================
# INDISPENSABLE
# =====================================================================

# Chaine de connexion PostgreSQL, sans "-pooler" dans l'adresse.
DATABASE_URL=postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Mot de passe d'acces au back-office /admin. Long et unique.
MOT_DE_PASSE_RECRUTEUR=changez-moi

# Adresse publique de l'application. Elle sert a construire les liens
# envoyes aux candidats : si elle est fausse, les liens ne marchent pas.
URL_PUBLIQUE=http://127.0.0.1:8000


# =====================================================================
# REGLAGES DES TESTS
# =====================================================================

# Duree de validite d'un lien d'invitation, en jours.
JOURS_VALIDITE=4

# Delai avant effacement automatique des identites, en jours.
# Les reponses, elles, sont conservees sans identite.
JOURS_CONSERVATION=180

# Fuseau utilise pour l'affichage des dates. Le serveur tourne en UTC.
FUSEAU=Europe/Paris


# =====================================================================
# PIGE DES ANNONCES (facultatif)
#
# Sans ces quatre valeurs, la page de pige s'ouvre et affiche un
# bandeau ; tout le reste de l'application fonctionne normalement.
# Avec une seule des deux sources, la collecte tourne sur celle-la.
#
#   France Travail : francetravail.io, creer une application et
#                    s'abonner a l'API "Offres d'emploi v2".
#   Adzuna         : developer.adzuna.com/signup
# =====================================================================

FT_CLIENT_ID=
FT_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Perimetre de la partie 2 (comptabilite et paie), modifiable sans
# toucher au code. Code INSEE de la commune, et rayon en kilometres.
# 92046 = Malakoff.
PIGE_COMMUNE=92046
PIGE_DISTANCE=10

# Age maximal d'une annonce, en jours. Au-dela, elle est ecartee :
# le poste est probablement pourvu.
PIGE_ANCIENNETE_MAX=120


# =====================================================================
# GUIDE D'ENTRETIEN GENERE AUTOMATIQUEMENT (facultatif)
#
# Laissez IA_CLE_API vide pour desactiver : la fonction disparait
# alors de l'interface, sans rien casser.
# =====================================================================

IA_FOURNISSEUR=anthropic
IA_CLE_API=

# claude-haiku-4-5-20251001 suffit et coute le moins cher.
# Passez a un modele Sonnet si vous trouvez les guides trop sommaires.
IA_MODELE=claude-haiku-4-5-20251001

# Delai d'attente de la reponse, en secondes.
IA_DELAI=60
